# .beadswave.env — per-repo override for bd-ship.

# ── HOLD classifier disabled ────────────────────────────────────────────
# Repo has `allow_auto_merge: false` and no branch protection on the fork,
# so GitHub auto-merge cannot be enabled — every HOLD ship orphans and
# requires a manual merge. Bypass the auto-classifier so ships go direct;
# `--hold` (FORCE_HOLD=true) still works for the rare case an operator
# genuinely wants a held PR.
BEADSWAVE_HOLD_DIFF_LINES=999999
BEADSWAVE_HOLD_FILE_COUNT=9999
BEADSWAVE_HOLD_GLOBS="__bw_hold_disabled_no_match__"
BEADSWAVE_HOLD_KEYWORDS="__bw_hold_disabled_no_match__"
